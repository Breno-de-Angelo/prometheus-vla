<mujoco model="g1_43dof scene">
  <include file="g1_29dof_with_hand.xml"/>
  <!-- Note that the hand model in g1_29dof_with_hand.xml is not stable for simulation. -->

  <!-- Grasp estavel: impratio alto (atrito rigido), cone eliptico, passe noslip.
       Padrao p/ objeto nao deslizar da garra (MuJoCo docs). -->
  <option impratio="50" cone="elliptic" noslip_iterations="15"/>

  <statistic center="0 0 0.5" extent="2.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="toalha_mat" rgba="0.96 0.96 0.93 1" shininess="0.0" specular="0.0" reflectance="0.0"/>
    <mesh name="copo_visual" file="copo_visual.obj"/>
    <mesh name="copo_hull"   file="copo_hull.obj"/>

    <!-- ArUcos da MESA (DICT_4X4_50, ids 0-3, 60mm) — os MESMOS impressos no real
         (gerados por assets/aruco/generate_aruco.py). Texturas copiadas p/
         assets/aruco_markers/. texuniform=false p/ a imagem aparecer 1x na face. -->
    <texture type="2d" name="aruco_t0" file="aruco_markers/table_id00.png"/>
    <texture type="2d" name="aruco_t1" file="aruco_markers/table_id01.png"/>
    <texture type="2d" name="aruco_t2" file="aruco_markers/table_id02.png"/>
    <texture type="2d" name="aruco_t3" file="aruco_markers/table_id03.png"/>
    <material name="aruco_m0" texture="aruco_t0" texuniform="false" specular="0" shininess="0" reflectance="0"/>
    <material name="aruco_m1" texture="aruco_t1" texuniform="false" specular="0" shininess="0" reflectance="0"/>
    <material name="aruco_m2" texture="aruco_t2" texuniform="false" specular="0" shininess="0" reflectance="0"/>
    <material name="aruco_m3" texture="aruco_t3" texuniform="false" specular="0" shininess="0" reflectance="0"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <!-- Site -->
    <site name="com_marker" pos="0.1 0 0" size="0.05" rgba="1 0 0 1" type="sphere"/>

  <!-- Mesa 180x79x75 cm (CxLxA). Tocando no chão (body z=0). -->
  <body name="mesa" pos="0.45 0 0">
      <!-- Tampo: 3cm espessura, topo em z=0.75 -->
      <geom name="geometria_mesa" type="box" size="0.395 0.90 0.015" pos="0 0 0.735"
            rgba="0.75 0.60 0.42 1" friction="1 0.005 0.0001"
            solref="0.005 1.0" solimp="0.99 0.999 0.0001"/>
      <!-- Toalha branca fosca presa ao tampo -->
      <geom name="toalha_mesa" type="box" size="0.405 0.91 0.002" pos="0 0 0.752"
            material="toalha_mat" friction="0.8 0.005 0.0001"
            solref="0.005 1.0" solimp="0.99 0.999 0.0001"/>
      <!-- 4 pernas: 3cm quadrado, dos 0 até 0.72m -->
      <geom name="perna_1" type="box" size="0.015 0.015 0.36" pos=" 0.370  0.875 0.36" rgba="0.65 0.50 0.35 1"/>
      <geom name="perna_2" type="box" size="0.015 0.015 0.36" pos=" 0.370 -0.875 0.36" rgba="0.65 0.50 0.35 1"/>
      <geom name="perna_3" type="box" size="0.015 0.015 0.36" pos="-0.370  0.875 0.36" rgba="0.65 0.50 0.35 1"/>
      <geom name="perna_4" type="box" size="0.015 0.015 0.36" pos="-0.370 -0.875 0.36" rgba="0.65 0.50 0.35 1"/>

      <!-- ArUcos 60mm colados na toalha (topo em z_local~0.754). Placas finas,
           visuais (sem colisão). Posições LOCAIS (mesa em world 0.45 0 0).
           Ajuste depois pra casar EXATO com a colagem física no real. -->
      <geom name="aruco0" type="box" size="0.03 0.03 0.0015" pos="-0.12  0.12 0.7555" material="aruco_m0" contype="0" conaffinity="0"/>
      <geom name="aruco1" type="box" size="0.03 0.03 0.0015" pos=" 0.05  0.12 0.7555" material="aruco_m1" contype="0" conaffinity="0"/>
      <geom name="aruco2" type="box" size="0.03 0.03 0.0015" pos="-0.12 -0.12 0.7555" material="aruco_m2" contype="0" conaffinity="0"/>
      <geom name="aruco3" type="box" size="0.03 0.03 0.0015" pos=" 0.05 -0.12 0.7555" material="aruco_m3" contype="0" conaffinity="0"/>
    </body>

    <!-- Copo branco — mesh real do objeto do lab. Base em z=0 no mesh. -->
    <!-- spawn 2mm acima da toalha para evitar penetração inicial -->
    <body name="objeto_customizado" pos="0.329 -0.081 0.756">
      <freejoint name="junta_livre_bloco"/>
      <!-- visual: mesh com aparência real, sem colisão -->
      <geom name="copo_geom_visual" type="mesh" mesh="copo_visual"
            rgba="0.97 0.97 0.95 1" contype="0" conaffinity="0" mass="0"/>
      <!-- colisão: cilindro simples alinhado ao centro do copo (raio=4.4cm, h=9.2cm)
           Centrado em z=0.046 (metade da altura) para coincidir com o mesh -->
      <geom name="geometria_bloco" type="cylinder" size="0.044 0.046" pos="0 0 0.046"
            rgba="0 0 0 0" mass="0.05" condim="4"
            friction="8.0 0.3 0.0" priority="2"
            solref="0.005 1.0" solimp="0.99 0.999 0.0001 0.5 2"/>
    </body>
    
    <!-- Third-person camera for visualization -->
    <camera name="global_view" pos="2.910 -5.040 3.860" xyaxes="0.866 0.500 0.000 -0.250 0.433 0.866" fovy="45"/>
  </worldbody>

  <default>
    <geom friction="1.0"/>
  </default>
</mujoco>
